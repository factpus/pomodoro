# Upstash Redis REST credentials. Vercel Marketplace injects these automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Used to build absolute social metadata URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 32-byte key used to encrypt Discord Webhook URLs at rest.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=

# Optional Discord App integration (/pomodoro and Activity).
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
NEXT_PUBLIC_DISCORD_CLIENT_ID=
